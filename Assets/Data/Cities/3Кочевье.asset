  info: "\u0412 \u043F\u0443\u0441\u0442\u044B\u043D\u0435 \u043D\u0435 \u0440\u0430\u0441\u0442\u0443\u0442
    \u0437\u043B\u0430\u043A\u0438, \u0434\u043E\u0431\u044B\u0442\u0447\u0438\u043A\u0430\u043C
    \u0441\u043E\u043B\u0438 \u0436\u0438\u0437\u043D\u0435\u043D\u043D\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C
    \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0439 \u043F\u0440\u0438\u0432\u043E\u0437
    \u0445\u043B\u0435\u0431\u0430."
  rumors:
  - "\u0421\u0442\u0430\u0440\u044B\u0439 \u0430\u043C\u0443\u043B\u0435\u0442\u0447\u0438\u043A,
    \u043E\u0431\u0443\u0447\u0430\u0432\u0448\u0438\u0439 \u0442\u0440\u0438 \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u044F
    \u0443\u0447\u0435\u043D\u0438\u043A\u043E\u0432, \u0432\u0447\u0435\u0440\u0430
    \u0443\u0442\u0440\u043E\u043C \u043D\u0435 \u0441\u043C\u043E\u0433 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u0442\u044C
    \u0431\u0430\u0437\u043E\u0432\u044B\u0439 \u0443\u0437\u0435\u043B \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F.
    \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0432\u0441\u0435 \u0441\u043C\u0435\u044F\u043B\u0438\u0441\u044C
    \u2014 \u0443\u0441\u0442\u0430\u043B \u0441\u0442\u0430\u0440\u0438\u043A. \u041F\u043E\u0442\u043E\u043C
    \u043E\u043D \u043D\u0435 \u0441\u043C\u043E\u0433 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u0442\u044C
    \u0438\u043C\u044F \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u0443\u0447\u0435\u043D\u0438\u043A\u0430, \u0441\u0438\u0434\u044F\u0449\u0435\u0433\u043E
    \u043F\u0440\u044F\u043C\u043E \u043F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C.
    \u041D\u0438\u043A\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435
    \u0441\u043C\u0435\u0451\u0442\u0441\u044F. \u0423\u0447\u0435\u043D\u0438\u043A
    \u0442\u043E\u0436\u0435."
  - "\u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u0438 \u041F\u0435\u043F\u043B\u0430
    \u0437\u0434\u0435\u0441\u044C \u2014 \u043A\u0430\u043A \u0434\u043E\u043C\u0430.
    \u0411\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E: \u0443 \u043D\u0438\u0445
    \u043B\u0435\u0433\u0430\u043B\u044C\u043D\u043E\u0435 \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u0438\u0435
    \u043A\u0430\u043A \u0443 \u043C\u0430\u0441\u0442\u0435\u0440\u043E\u0432-\u0430\u043C\u0443\u043B\u0435\u0442\u0447\u0438\u043A\u043E\u0432.
    \u041E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445 \u0432\u0447\u0435\u0440\u0430
    \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u0441\u0442\u0440\u0430\u043D\u043D\u0438\u043A\u0443
    \"\u0430\u043C\u0443\u043B\u0435\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043F\u0443\u0442\u044C\".
    \u041A\u043E\u0433\u0434\u0430 \u0441\u043F\u0440\u043E\u0441\u0438\u043B\u0438,
    \u043A\u0443\u0434\u0430 \u2014 \u043E\u043D \u0437\u0430\u043C\u043E\u043B\u0447\u0430\u043B
    \u0438 \u0441\u043A\u0430\u0437\u0430\u043B: \"\u0422\u0443\u0434\u0430, \u043A\u0443\u0434\u0430
    \u0442\u044B \u0443\u0436\u0435 \u0435\u0434\u0435\u0448\u044C\". \u041F\u0440\u043E\u0434\u0430\u043B
    \u0437\u0430 \u043F\u043E\u043B\u0446\u0435\u043D\u044B."
  availableUnits:
  - {fileID: 11400000, guid: e8de9d8b7ea01c3418297d56542e6006, type: 2}
  - {fileID: 11400000, guid: 76678fddff353b54e9c0ef258de7feea, type: 2}
