  info: "\u0421\u0442\u043E\u043B\u0438\u0446\u0430 \u043C\u0438\u0440\u0430. \u041F\u044B\u043B\u044C\u043D\u044B\u0435
    \u0443\u043B\u0438\u0446\u044B, \u0434\u0435\u0441\u044F\u0442\u043A\u0438 \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u043E\u0432.
    \u0412\u0435\u0440\u0445\u043D\u0438\u0439 \u0433\u043E\u0440\u043E\u0434 \u2014
    \u0434\u0432\u043E\u0440\u0435\u0446 \u0438 \u043C\u0430\u0433\u0438; \u043D\u0438\u0436\u043D\u0438\u0439
    \u2014 \u0448\u0443\u043C\u043D\u044B\u0435 \u0440\u044B\u043D\u043A\u0438.\n\u0421\u0442\u043E\u043B\u0438\u0447\u043D\u044B\u043C
    \u043C\u0430\u0433\u0430\u043C \u0438 \u043E\u0440\u0443\u0436\u0435\u0439\u043D\u0438\u043A\u0430\u043C
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C \u041F\u0440\u0430\u0445
    \u0442\u043B\u0435\u044E\u0449\u0438\u0445 \u0438\u0444\u0440\u0438\u0442\u043E\u0432
    \u0434\u043B\u044F \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0440\u0438\u0442\u0443\u0430\u043B\u043E\u0432 \u0438 \u043A\u043E\u0432\u043A\u0438."
  rumors:
  - "\u041D\u0438\u0436\u043D\u0438\u0439 \u043A\u0432\u0430\u0440\u0442\u0430\u043B
    \u0436\u0438\u0432\u0451\u0442 \u043F\u043E \u0441\u0432\u043E\u0438\u043C \u0446\u0435\u043D\u0430\u043C.
    \u0412\u0447\u0435\u0440\u0430 \u043E\u0434\u0438\u043D \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
    \u043F\u0440\u043E\u0434\u0430\u043B \u043C\u0435\u0448\u043E\u043A \u0444\u0438\u043D\u0438\u043A\u043E\u0432
    \u0437\u0430 \u0442\u0440\u0438\u0436\u0434\u044B \u0435\u0433\u043E \u0432\u0435\u0441
    \u0432 \u043C\u0435\u0434\u0438 \u2014 \u0438 \u043E\u0431\u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u044B
    \u0443\u0448\u043B\u0438 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u0435.
    \u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043D\u0438 \u043E\u0434\u0438\u043D
    \u043D\u0435 \u043F\u043E\u043C\u043D\u0438\u043B, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u043C\u0435\u0434\u0438 \u0432 \u043C\u0435\u0448\u043A\u0435 \u043D\u0430 \u0441\u0430\u043C\u043E\u043C
    \u0434\u0435\u043B\u0435."
  - "\u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u0441\u0443\u043B\u0442\u0430\u043D
    \u0432\u0447\u0435\u0440\u0430 \u043F\u0440\u043E\u0438\u0437\u043D\u0451\u0441
    \u0440\u0435\u0447\u044C \u043E \u043F\u0440\u043E\u0446\u0432\u0435\u0442\u0430\u043D\u0438\u0438.
    \u0422\u0440\u0438 \u0441\u043E\u0432\u0435\u0442\u043D\u0438\u043A\u0430 \u0445\u043B\u043E\u043F\u0430\u043B\u0438
    \u0432 \u043B\u0430\u0434\u043E\u0448\u0438. \u041F\u043E\u0442\u043E\u043C \u0432\u044B\u044F\u0441\u043D\u0438\u043B\u043E\u0441\u044C,
    \u0447\u0442\u043E \u0434\u0432\u0430 \u0438\u0437 \u043D\u0438\u0445 \u0445\u043B\u043E\u043F\u0430\u043B\u0438,
    \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0437\u0430\u0431\u044B\u043B\u0438,
    \u0437\u0430\u0447\u0435\u043C \u0441\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C.
    \u0422\u0440\u0435\u0442\u0438\u0439 \u043F\u0440\u043E\u0441\u0442\u043E \u043B\u044E\u0431\u0438\u0442
    \u0445\u043B\u043E\u043F\u0430\u0442\u044C."
  isCapital: 1
